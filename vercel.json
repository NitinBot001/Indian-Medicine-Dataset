{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "bindings": [
        {
          "type": "service",
          "service": "medicine-search-backend",
          "format": "url",
          "env": "MEDICINE_SEARCH_BACKEND_URL"
        }
      ]
    },
    "medicine-search-backend": {
      "root": "medicine-search-backend",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "medicine-search-backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "medicine-search-backend"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "medicine-search-backend"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "medicine-search-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
